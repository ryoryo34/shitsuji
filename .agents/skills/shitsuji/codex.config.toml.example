# Codex configuration for the project-local shitsuji Skill.
#
# Hooks are registered from project-local `.codex/hooks.json` in current Codex.
# Keep only the feature flag in TOML.

[features]
hooks = true

# Optional environment knobs used by the hook command:
#   SHITSUJI_DISABLED=1    — temporarily disables UserPromptSubmit hook
#   SHITSUJI_DATA_DIR=...  — relocate runtime data files
#   SHITSUJI_AUTO_APPEND=0 — disable project-level auto memory
#
# Project-level hook example lives at `<project>/.codex/hooks.json`.
#
# Minimal hooks.json:
# {
#   "hooks": {
#     "SessionStart": [
#       {
#         "matcher": "startup|resume",
#         "hooks": [
#           {
#             "type": "command",
#             "command": "SHITSUJI_PROJECT_ROOT=\"/absolute/path/to/project\" SHITSUJI_CWD=\"/absolute/path/to/project\" SHITSUJI_DATA_DIR=\"/absolute/path/to/project/.shitsuji\" python3 \"/absolute/path/to/shitsuji/.agents/hooks/shitsuji/session_start.py\"",
#             "timeout": 30
#           }
#         ]
#       }
#     ],
#     "UserPromptSubmit": [
#       {
#         "hooks": [
#           {
#             "type": "command",
#             "command": "SHITSUJI_PROJECT_ROOT=\"/absolute/path/to/project\" python3 \"/absolute/path/to/shitsuji/.agents/hooks/shitsuji/codex_project_user_prompt_submit.py\"",
#             "timeout": 10
#           }
#         ]
#       }
#     ]
#   }
# }
